---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, business } from '../lib/site';
import { plumberSchema } from '../lib/seo';
import { siteConfig } from '../data/siteConfig';
import { u } from '../lib/utils';
const { title, description, path, noindex = false } = Astro.props;
const canonical = `${SITE_URL}${path === '/' ? '/' : path}`;
const ogImage = `${SITE_URL}/images/hydro-jetting-hero.png`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={business.name} />
    <meta name="theme-color" content="#13234a" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Technician feeding a hydro jetting hose into a sewer cleanout" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga4MeasurementId}`}></script>
    <script is:inline define:vars={{ id: siteConfig.ga4MeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', id);
    </script>
    <JsonLd data={plumberSchema(path, title)} />
    <slot name="head" />
  </head>
  <body class="antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-cta focus:px-4 focus:py-2 focus:text-cta-foreground">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script>import '../scripts/lead-form.js';</script>
    <script is:inline defer src={import.meta.env.BASE_URL.replace(/\/$/,'')+'/assets/call-fx.js'}></script>
    <script is:inline defer src="https://api.airchatty.com/js/external-tracking.js" data-tracking-id={siteConfig.airchattyTrackingId}></script>
  </body>
</html>

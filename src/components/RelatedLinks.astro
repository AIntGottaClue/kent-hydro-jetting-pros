---
import Link from './Link.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { ArrowRight } from '@lucide/astro';
const { links } = Astro.props;
---
<Section muted>
  <SectionHeading title="Related pages" />
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {links.map((link) => (
      <li>
        <Link href={link.href} class="group flex h-full flex-col rounded-lg border border-border bg-card p-6 transition-shadow hover:shadow-md">
          <span class="font-heading text-lg font-bold text-primary group-hover:underline">{link.title}</span>
          <span class="mt-2 text-sm leading-relaxed text-muted-foreground">{link.description}</span>
          <ArrowRight class="mt-4 size-4 text-ring" aria-hidden="true" />
        </Link>
      </li>
    ))}
  </ul>
</Section>

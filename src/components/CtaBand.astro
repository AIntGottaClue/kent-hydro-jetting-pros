---
import { Phone } from '@lucide/astro';
import { business } from '../lib/site';
const { title, text } = Astro.props;
---
<section class="bg-accent">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-12 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold text-accent-foreground sm:text-3xl">{title}</h2>
      <p class="mt-2 text-accent-foreground/80">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={business.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground hover:bg-primary/90 cta-call">
        <Phone class="size-4" aria-hidden="true" />
        {business.phoneDisplay}
      </a>
      <a href="#request-service" class="inline-flex items-center justify-center rounded-md bg-cta px-5 py-3 font-semibold text-cta-foreground hover:bg-cta/90 cta-request">Request Service</a>
    </div>
  </div>
</section>

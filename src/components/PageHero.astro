---
import { Check, ChevronRight, Phone } from '@lucide/astro';
import RequestForm from './RequestForm.astro';
import { business } from '../lib/site';
import { u } from '../lib/utils';
const { title, intro, points, breadcrumb, image, formHeading, location = 'Homepage' } = Astro.props;
---
<section class="relative overflow-hidden bg-primary text-primary-foreground">
  {image && <img src={u(image.src)} alt="" width="1376" height="768" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover opacity-25" />}
  <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/95 to-primary/70" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-14 lg:px-8 lg:py-20">
    <div>
      {breadcrumb && (
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center gap-1 text-sm text-primary-foreground/70">
            <li><a href={u('/')} class="hover:text-primary-foreground hover:underline">Home</a></li>
            {breadcrumb.map((crumb) => (
              <li class="flex items-center gap-1">
                <ChevronRight class="size-3.5" aria-hidden="true" />
                <span aria-current="page">{crumb.label}</span>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-[3.4rem]">{title}</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-primary-foreground/85">{intro}</p>
      {points && (
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {points.map((point) => (
            <li class="flex items-start gap-2.5 text-primary-foreground/90">
              <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-accent text-accent-foreground"><Check class="size-3.5" aria-hidden="true" /></span>
              {point}
            </li>
          ))}
        </ul>
      )}
      <a href={business.phoneHref} class="mt-8 inline-flex items-center gap-3 rounded-md border border-primary-foreground/30 px-5 py-3 font-semibold hover:bg-primary-foreground/10 cta-call">
        <Phone class="size-5" aria-hidden="true" />
        Call {business.phoneDisplay}
      </a>
      <a href="#request-service" class="cta-request ml-3 mt-3 inline-flex items-center justify-center rounded-md px-5 py-3 font-semibold">Request Service</a>
    </div>
    <RequestForm heading={formHeading} location={location} />
  </div>
</section>

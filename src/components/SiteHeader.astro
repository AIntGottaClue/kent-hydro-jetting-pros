---
import { ChevronDown, Menu, Phone, X } from '@lucide/astro';
import Logo from './Logo.astro';
import { business, navLinks } from '../lib/site';
import { servicePages } from '../data/servicePages';
import { areas } from '../data/areas';
import { cn, u } from '../lib/utils';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-50 border-b border-border bg-card/95 backdrop-blur supports-[backdrop-filter]:bg-card/85">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:h-20 lg:px-8">
    <Logo />
    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {navLinks.map((link) => {
          const active = path === link.href || (link.href === '/service-areas' && path.startsWith('/service-areas'));
          const linkClass = cn('rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-muted hover:text-primary', active ? 'text-primary underline decoration-accent decoration-2 underline-offset-8' : 'text-muted-foreground');
          return link.href === '/service-areas' || link.href === '/services' ? (
            <li class="group relative">
              <a href={u(link.href)} aria-current={active ? 'page' : undefined} class={cn(linkClass, 'inline-flex items-center gap-1')}>{link.label}<ChevronDown class="size-3.5" aria-hidden="true" /></a>
              <ul class="invisible absolute left-0 top-full z-50 grid min-w-56 gap-0.5 rounded-lg border border-border bg-card p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {(link.href === '/services' ? servicePages : areas).map((area) => (
                  <li><a href={u(`${link.href}/${area.slug}`)} class="block rounded-md px-3 py-2 text-sm text-foreground hover:bg-muted hover:text-primary">{area.name}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={u(link.href)} aria-current={active ? 'page' : undefined} class={linkClass}>{link.label}</a></li>
          );
        })}
      </ul>
    </nav>
    <div class="hidden items-center gap-4 xl:flex">
      <a href={business.phoneHref} class="flex items-center gap-2 text-sm font-semibold text-primary hover:underline rounded-md cta-call"><Phone class="size-4" aria-hidden="true" />{business.phoneDisplay}</a>
      <a href="#request-service" class="rounded-md bg-cta px-4 py-2.5 text-sm font-semibold text-cta-foreground transition-colors hover:bg-cta/90 cta-request">Request Service</a>
    </div>
    <div class="flex items-center gap-2 xl:hidden">
      <a href={business.phoneHref} class="flex items-center gap-2 rounded-md bg-cta px-3 py-2 text-sm font-semibold text-cta-foreground cta-call"><Phone class="size-4" aria-hidden="true" /><span>Call Now</span></a>
      <button type="button" data-menu-button aria-expanded="false" aria-controls="mobile-menu" class="inline-flex size-10 items-center justify-center rounded-md border border-border text-primary">
        <Menu class="size-5 menu-open" aria-hidden="true" />
        <X class="size-5 menu-close hidden" aria-hidden="true" />
        <span class="sr-only">Toggle menu</span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" hidden class="border-t border-border bg-card xl:hidden">
    <nav aria-label="Mobile" class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
      <ul class="flex flex-col">
        {navLinks.map((link) => {
          const active = path === link.href || (link.href === '/service-areas' && path.startsWith('/service-areas'));
          return (
            <li>
              <a href={u(link.href)} aria-current={active ? 'page' : undefined} class={cn('block rounded-md px-3 py-3 text-base font-medium hover:bg-muted', active ? 'bg-muted text-primary' : 'text-foreground')}>{link.label}</a>
              {(link.href === '/service-areas' || link.href === '/services') && (
                <ul class="mb-2 ml-4 grid grid-cols-2 gap-x-2 border-l border-border pl-3">
                  {(link.href === '/services' ? servicePages : areas).map((area) => (
                    <li><a href={u(`${link.href}/${area.slug}`)} class="block rounded-md px-2 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-primary">{area.name}</a></li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <a href={business.phoneHref} class="flex items-center justify-center gap-2 rounded-md border border-primary px-4 py-3 font-semibold text-primary cta-call"><Phone class="size-4" aria-hidden="true" />Tap to Call {business.phoneDisplay}</a>
        <a href="#request-service" data-close-menu class="flex items-center justify-center rounded-md bg-cta px-4 py-3 font-semibold text-cta-foreground cta-request">Request Service</a>
      </div>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector('[data-menu-button]');
  const menu = document.getElementById('mobile-menu');
  function set(open) {
    if (!btn || !menu) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.menu-open')?.classList.toggle('hidden', open);
    btn.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  }
  btn?.addEventListener('click', () => set(menu.hidden));
  document.querySelector('[data-close-menu]')?.addEventListener('click', () => set(false));
</script>

<style is:global>
/* Mobile menu sits above fixed call CTAs. Icons track aria-expanded. */
header:has([aria-expanded="true"]){z-index:2001!important}
.mobile-menu-x{display:none!important}
[aria-expanded="true"]>.mobile-menu-hamburger{display:none!important}
[aria-expanded="true"]>.mobile-menu-x{display:block!important}
.mobile-menu-hamburger,.mobile-menu-x{flex:none;vertical-align:middle}
/* Menu icons: no square around hamburger/X. */
button[data-menu-toggle],button[data-menu],button[data-burger],button[data-mobile-menu],button.menu,button.menu-toggle,button.menu-btn,button.burger,.menu-toggle,.menu-btn,.burger{border:0!important;border-radius:0!important;box-shadow:none!important;background:transparent!important;outline:0}
button[data-menu-toggle]:focus-visible,button[data-menu]:focus-visible,button[data-mobile-menu]:focus-visible,button[data-burger]:focus-visible,button.menu:focus-visible,button.menu-toggle:focus-visible,button.menu-btn:focus-visible,button.burger:focus-visible{outline:2px solid currentColor!important;outline-offset:4px}
button[data-menu-toggle],button[data-menu],button[data-burger],button[data-mobile-menu],button.menu{min-width:44px;min-height:44px;align-items:center;justify-content:center}
button[data-menu-toggle]:focus-visible,button[data-menu]:focus-visible,button[data-mobile-menu]:focus-visible,button[data-burger]:focus-visible,button.menu:focus-visible{outline:2px solid currentColor;outline-offset:4px}
.mobile-nav,.sat-mobile-panel,#mobile-menu,.mobile-panel{max-height:calc(100dvh - 100px);overflow-y:auto;overscroll-behavior:contain}
@media(max-width:1100px){header:has([aria-expanded="true"]){position:sticky;top:0}}

</style>

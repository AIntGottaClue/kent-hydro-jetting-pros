---
import { Phone } from '@lucide/astro';
import { business } from '../lib/site';
---
<a href={business.phoneHref} class="fab-deal" aria-label={`Call ${business.name} at ${business.phoneDisplay}`}>
  <span class="fab-deal-ico" aria-hidden="true"><Phone /></span>
  <span class="fab-deal-text"><span class="fab-deal-text-k">{business.name}</span><span class="fab-deal-text-v">{business.phoneDisplay}</span></span>
</a>
<script is:inline>
(function(){function run(){if(!('IntersectionObserver' in window))return;var forms=document.querySelectorAll('form[data-lead-form]');if(!forms.length)return;var fx=[].filter.call(document.querySelectorAll('body *'),function(e){return getComputedStyle(e).position==='fixed'&&!e.closest('header')&&(e.matches('a[href^="tel:"]')||e.querySelector('a[href^="tel:"]'))&&e.getClientRects().length});if(!fx.length)return;fx.forEach(function(e){e.style.transition='opacity .2s ease'});var vis=new Set();var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){vis.add(x.target)}else{vis.delete(x.target)}});fx.forEach(function(e){e.style.opacity=vis.size?'0':'';e.style.pointerEvents=vis.size?'none':''})});forms.forEach(function(f){io.observe(f)})}if(document.readyState==='complete'){run()}else{window.addEventListener('load',run)}})();
</script>

---
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';
import JsonLd from './JsonLd.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { MapPin } from '@lucide/astro';
import { hoods } from '../data/areas';
import { SITE_URL, business } from '../lib/site';
import { hoodHtml } from '../lib/hoodText';
import { u } from '../lib/utils';
const { a } = Astro.props;
const svcUrl = (s: string) => u(`/services/${s}`);
const h = (t: string) => hoodHtml(t, svcUrl);
const path = `/service-areas/${a.slug}`;
const pageUrl = `${SITE_URL}${path}`;
const others = hoods.filter((x) => x.slug !== a.slug);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', '@id': `${pageUrl}#service`, name: `Hydro jetting in ${a.name}, Kent, Ohio`, serviceType: 'Hydro jetting', provider: { '@id': `${SITE_URL}/#business` }, areaServed: { '@type': 'Place', name: `${a.name}, Kent, Ohio` }, description: a.description },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Neighborhoods', item: `${SITE_URL}/service-areas` },
    { '@type': 'ListItem', position: 3, name: a.name, item: pageUrl } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const prose = 'mt-6 space-y-4 text-lg leading-relaxed text-muted-foreground [&_a]:text-primary [&_a]:underline';
---
{schema.map((s) => <JsonLd data={s} />)}
<PageHero
  location={`${a.name}, Kent, OH`}
  title={`Hydro Jetting in ${a.name}, Kent OH`}
  intro={a.hero}
  points={['Homes and businesses', 'Camera inspection available', `Serving ${a.name}`, 'Grease, roots and scale']}
  breadcrumb={[{ href: '/service-areas', label: 'Neighborhoods' }, { href: path, label: a.name }]}
  image={{ src: '/images/hydro-jetting-hero.png', alt: '' }}
  formHeading="Request Service"
/>
<Section>
  <div class="max-w-4xl">
    <SectionHeading title={a.bodyH2} />
    <div class={prose}>{a.bodyPs.map((p: string) => <p set:html={h(p)} />)}</div>
    <h3 class="mt-8 text-xl font-bold text-primary">What Local Property Owners Often Consider</h3>
    <ul class="mt-4 list-disc space-y-2 pl-6 text-muted-foreground">{a.considerations.map((c: string) => <li>{c}</li>)}</ul>
  </div>
</Section>
<Section muted>
  <div class="max-w-4xl">
    <SectionHeading title={a.svcH2} intro={a.svcLead} />
    <div class={prose}>{Object.values(a.svc).map((p: any) => <p set:html={h(p)} />)}</div>
  </div>
</Section>
<Section>
  <div class="max-w-4xl">
    <SectionHeading title={a.appsH2} />
    <div class="mt-6 space-y-6">{a.apps.map((x: any) => <div><h3 class="text-xl font-bold text-primary">{x.h}</h3><p class="mt-2 text-lg leading-relaxed text-muted-foreground [&_a]:text-primary [&_a]:underline" set:html={h(x.p)} /></div>)}</div>
  </div>
</Section>
<Section muted>
  <div class="max-w-4xl">
    <SectionHeading title={a.implH2} />
    <div class={prose}>{a.implPs.map((p: string) => <p>{p}</p>)}</div>
    <div class="mt-6 space-y-6">{a.impl.map((x: any) => <div><h3 class="text-xl font-bold text-primary">{x.h}</h3><p class="mt-2 text-lg leading-relaxed text-muted-foreground [&_a]:text-primary [&_a]:underline" set:html={h(x.p)} /><ul class="mt-3 list-disc space-y-1 pl-6 text-muted-foreground">{x.b.map((b: string) => <li>{b}</li>)}</ul></div>)}</div>
  </div>
</Section>
<Section>
  <SectionHeading title={a.planH2} intro={a.planPs[0]} />
  <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">{a.steps.map((s: any, i: number) => <li class="rounded-lg border border-border bg-card p-5"><span class="text-sm font-bold text-ring">{String(i + 1).padStart(2, '0')}</span><h3 class="mt-1 font-bold text-primary">{s.t}</h3><p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.d}</p></li>)}</ol>
</Section>
<Section muted>
  <SectionHeading title={a.mapH2} intro={a.mapIntro} />
  <div class="mt-8 overflow-hidden rounded-lg border border-border"><iframe src={a.map.src} width="100%" height="420" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={a.map.label}></iframe></div>
</Section>
<Section>
  <SectionHeading title={a.nearbyH2} intro={a.nearbyP} />
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {others.map((n) => (<li><a href={u(`/service-areas/${n.slug}`)} class="group flex items-center gap-2 rounded-lg border border-border bg-card p-5 font-semibold text-primary hover:shadow-md"><MapPin class="size-4 text-ring" aria-hidden="true" /><span class="group-hover:underline">{n.name}</span></a></li>))}
  </ul>
</Section>
<Section muted>
  <SectionHeading title={`Hydro jetting questions in ${a.name}`} />
  <div class="mt-8 space-y-5">{a.faqs.map((f: any) => <details class="rounded-md border border-border bg-card p-5"><summary class="font-semibold text-primary cursor-pointer">{f.q}</summary><p class="mt-3 text-muted-foreground leading-relaxed">{f.a}</p></details>)}</div>
</Section>
<Section>
  <div class="max-w-4xl"><SectionHeading title={a.ctaH2} /><div class={prose}>{a.ctaPs.map((p: string) => <p>{p}</p>)}</div></div>
</Section>
<CtaBand title={`Need hydro jetting in ${a.name}?`} text="Include your address and what the drain is doing, and we will follow up." />

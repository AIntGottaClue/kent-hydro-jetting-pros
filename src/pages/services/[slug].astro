---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import JsonLd from '../../components/JsonLd.astro';
import Section from '../../components/Section.astro';
import { servicePages } from '../../data/servicePages';
import { SITE_URL, business } from '../../lib/site';
import { u } from '../../lib/utils';
export function getStaticPaths() { return servicePages.map(service => ({params:{slug:service.slug},props:{service}})); }
const {service:s}=Astro.props;
const path=`/services/${s.slug}`;
const title=`${s.name} in Kent, Ohio | ${business.name}`;
const schema=[{'@context':'https://schema.org','@type':'Service',name:s.name,serviceType:s.name,url:SITE_URL+path,provider:{'@id':SITE_URL+'/#business'},areaServed:{'@type':'City',name:'Kent, Ohio'}},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:s.faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}];
---
<Base title={title} description={s.intro} path={path}>
  <Fragment slot="head">{schema.map(data=><JsonLd data={data}/>)}</Fragment>
  <PageHero title={`${s.name} in Kent, Ohio`} intro={s.intro} breadcrumb={[{href:'/services',label:'Services'},{href:path,label:s.name}]} location={s.name}/>
  {s.sections.map(([heading,paragraphs],i)=><Section muted={i%2===1}><div class="max-w-4xl"><h2 class="text-3xl font-bold text-primary">{heading}</h2>{paragraphs.map(p=><p class="mt-5 leading-relaxed text-muted-foreground">{p}</p>)}</div></Section>)}
  <Section><h2 class="text-3xl font-bold text-primary">{s.name} FAQs</h2><div class="mt-7 max-w-4xl">{s.faqs.map(([q,a])=><details class="border-b border-border py-5"><summary class="cursor-pointer font-semibold text-primary">{q}</summary><p class="mt-4 leading-relaxed text-muted-foreground">{a}</p></details>)}</div></Section>
  <Section muted><h2 class="text-2xl font-bold text-primary">Reference sources</h2><ul class="mt-5 space-y-3">{s.sources.map(([href,label])=><li><a href={href} class="text-primary underline" rel="noopener">{label}</a></li>)}</ul><h2 class="mt-9 text-2xl font-bold text-primary">Related services</h2><ul class="mt-5 space-y-3"><li><a href={u('/hydro-jetting')} class="text-primary underline">Hydro Jetting</a></li>{servicePages.filter(x=>x.slug!==s.slug).map(x=><li><a href={u(`/services/${x.slug}`)} class="text-primary underline">{x.name}</a></li>)}</ul></Section>
  <CtaBand title="Describe the affected drain" text="Tell us which fixtures are involved and whether the blockage keeps returning."/>
</Base>

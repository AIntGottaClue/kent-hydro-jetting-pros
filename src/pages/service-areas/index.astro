---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TextLink from '../../components/TextLink.astro';
import Prose from '../../components/Prose.astro';
import Link from '../../components/Link.astro';
import { AlertTriangle, Building2, Camera, House as HomeIcon, MapPin, Waves, Check, ChevronDown, Mail, Phone } from '@lucide/astro';
import { faqs } from '../../lib/faqs';
import { faqSchema } from '../../lib/seo';
import { business } from '../../lib/site';
import { areas } from '../../data/areas';
import { cn, u } from '../../lib/utils';
const title = 'Kent, Ohio Neighborhoods We Serve | Hydro Jetting'
const description = 'Kent Hydro Jetting Pros serves Kent neighborhoods including the Historic South End, the Mill District, West Main Street and the Fairchild Avenue and Haymaker Parkway area.'
const path = '/service-areas';
const home = areas[0];
const nearby = areas.slice(1);
---
<Base title={title} description={description} path={path}>

  <PageHero
  location={path === '/' ? 'Homepage' : title}
    title="Hydro Jetting in Kent Neighborhoods"
    intro="Kent grew in distinct areas over time. Each neighborhood page covers how its history shapes drain line questions."
    points={['Based in Kent, Ohio', 'Residential and commercial', 'Neighborhood pages', 'Camera inspection available']}
    breadcrumb={[{ href: '/service-areas', label: 'Neighborhoods' }]}
  />

  <Section>
    <div class="rounded-xl bg-primary p-8 text-primary-foreground sm:p-10">
      <h2 class="mt-2 text-3xl font-bold">Hydro jetting in {home.name}, Ohio</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-primary-foreground/85">
        Kent is where we are based. We clear sewer laterals, kitchen and laundry lines, basement floor drains and
        commercial grease lines for homes, rentals and businesses across the city.
      </p>
      <a href={u('/service-areas/kent')} class="cta-request mt-6 inline-flex rounded-md px-4 py-2.5 text-sm font-semibold">Hydro jetting in Kent</a>
    </div>

    <div class="mt-14">
      <SectionHeading
        title="Neighborhoods in Kent"
        intro="Choose the neighborhood closest to your property."
      />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {nearby.map((town) => (
          <li>
            <a href={u(`/service-areas/${town.slug}`)} class="group flex h-full items-start gap-3 rounded-lg border border-border bg-card p-5 transition-shadow hover:shadow-md">
              <MapPin class="mt-0.5 size-5 shrink-0 text-ring" aria-hidden="true" />
              <div>
                <h3 class="font-bold text-primary group-hover:underline">Hydro jetting in {town.name}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{town.intro}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section muted>
    <SectionHeading
      title="Don't see your street?"
      intro={`If your street is not listed, call ${business.phoneDisplay} or send a request with your address and we will let you know.`}
    />
  </Section>

  <RelatedLinks
    links={[
      { href: '/services', title: 'Services', description: 'What we offer in each of these communities.' },
      { href: '/hydro-jetting', title: 'Hydro jetting', description: 'How high-pressure jetting clears your lines.' },
      { href: '/contact', title: 'Contact', description: 'Get in touch to request service at your address.' },
    ]}
  />

  <CtaBand title="Need hydro jetting near Kent?" text="Include your address in the request form so we can confirm service in your area." />
</Base>

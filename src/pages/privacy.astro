---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import JsonLd from '../components/JsonLd.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TextLink from '../components/TextLink.astro';
import Prose from '../components/Prose.astro';
import Link from '../components/Link.astro';
import { AlertTriangle, Building2, Camera, House as HomeIcon, MapPin, Waves, Check, ChevronDown, Mail, Phone } from '@lucide/astro';
import { faqs } from '../lib/faqs';
import { faqSchema } from '../lib/seo';
import { business, serviceAreas } from '../lib/site';
import { cn, u } from '../lib/utils';
const title = 'Privacy Policy | Kent Hydro Jetting Pros'
const description =
  'Read how Kent Hydro Jetting Pros collects, uses and protects the information you share through our website and service request form.'
const path = '/privacy';
---
<Base title={title} description={description} path={path}>

  <PageHero
  location={path === '/' ? 'Homepage' : title}
    title="Privacy Policy"
    intro="This policy explains what information we collect through this website, how we use it and the choices you have."
    breadcrumb={[{ href: '/privacy', label: 'Privacy' }]}
  />
  <Section>
    <Prose>
      <h2>Information we collect</h2>
      <p>
        When you submit our service request form, we collect the details you provide: your name, phone number, email
        address, service address, the service you need and your message. We may also collect basic, non-identifying
        usage data such as pages visited and browser type to help us improve the website.
      </p>
      <h2>How we use your information</h2>
      <ul>
        <li>To respond to your request and schedule service</li>
        <li>To communicate with you about your drain or sewer line</li>
        <li>To improve our website and services</li>
      </ul>
      <h2>Sharing your information</h2>
      <p>
        We do not sell your personal information. We may share it with service providers that help us operate this
        website or communicate with you, and when required by law.
      </p>
      <h2>Data security</h2>
      <p>
        We take reasonable measures to protect the information you share with us. No method of transmission over the
        internet is completely secure, so we cannot ensure absolute security.
      </p>
      <h2>Your choices</h2>
      <p>
        You may ask us to update or delete the personal information you have provided by calling us at {business.phoneDisplay} or using the <a href={u('/contact')}>contact page</a>.
      </p>
      <h2>Changes to this policy</h2>
      <p>We may update this policy from time to time. Changes take effect when posted on this page.</p>
      <p>
        See also our <a href={u('/terms')}>Terms of Use</a>.
      </p>
    </Prose>
  </Section>
</Base>
